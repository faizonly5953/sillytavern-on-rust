{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SillyTavern RS",
  "version": "../package.json",
  "identifier": "com.sillytavern.rs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SillyTavern RS",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4OEEyNUEyQzI2NzdGRUIKUldUcmYyZkNvaVdLNkVwUjVxRFJ0NE10V2pkTFR6NE5YQ2ljeXJzbkJwWXBkRFVucFJrZ3RIblAK",
      "endpoints": [
        "https://github.com/faizonly5953/sillytavern-on-rust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
